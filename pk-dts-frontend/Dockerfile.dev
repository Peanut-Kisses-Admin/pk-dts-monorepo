# syntax=docker/dockerfile:1.7
FROM node:20-bookworm-slim

WORKDIR /app

ENV NODE_ENV=development \
    CHOKIDAR_USEPOLLING=true \
    WATCHPACK_POLLING=true \
    npm_config_fetch_retries=5 \
    npm_config_fetch_retry_mintimeout=20000 \
    npm_config_fetch_retry_maxtimeout=120000 \
    npm_config_fetch_timeout=300000 \
    npm_config_maxsockets=5

COPY package*.json ./

# The frontend lockfile is maintained with npm 11. Keep that npm major in the
# dev image, but cache downloads and retry transient network failures.
RUN --mount=type=cache,target=/root/.npm \
    sh -c 'set -e; \
      for attempt in 1 2 3 4; do \
        echo "Installing npm 11 (attempt ${attempt}/4)"; \
        if npm install -g npm@11.16.0 --no-audit --no-fund; then \
          break; \
        fi; \
        if [ "$attempt" -eq 4 ]; then \
          echo "Unable to install npm 11 after 4 attempts" >&2; \
          exit 1; \
        fi; \
        delay=$((attempt * 10)); \
        echo "npm upgrade failed; retrying in ${delay}s..."; \
        sleep "$delay"; \
      done; \
      for attempt in 1 2 3 4; do \
        echo "npm ci attempt ${attempt}/4"; \
        if npm ci --prefer-offline --no-audit --no-fund; then \
          exit 0; \
        fi; \
        if [ "$attempt" -eq 1 ]; then \
          echo "npm ci rejected the lockfile; trying a development-only install without rewriting package-lock.json"; \
          if npm install --prefer-offline --no-audit --no-fund --package-lock=false; then \
            exit 0; \
          fi; \
        fi; \
        if [ "$attempt" -eq 4 ]; then \
          echo "Frontend dependency installation failed after 4 attempts" >&2; \
          exit 1; \
        fi; \
        delay=$((attempt * 10)); \
        echo "Dependency install failed; retrying in ${delay}s..."; \
        sleep "$delay"; \
      done'

# Source is bind-mounted by compose.dev.yaml. node_modules stays in a Docker
# volume, so Angular can hot reload without rebuilding the image.
EXPOSE 4200

CMD ["npm", "start", "--", "--host", "0.0.0.0", "--port", "4200", "--poll", "1000", "--hmr"]
