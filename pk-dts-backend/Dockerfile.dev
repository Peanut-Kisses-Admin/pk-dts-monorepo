# syntax=docker/dockerfile:1.7
FROM node:20-bookworm-slim

WORKDIR /app

RUN set -eux; \
    for source_file in /etc/apt/sources.list /etc/apt/sources.list.d/debian.sources; do \
      if [ -f "$source_file" ]; then \
        sed -i 's|http://deb.debian.org|https://deb.debian.org|g' "$source_file"; \
      fi; \
    done; \
    attempt=1; \
    until apt-get -o Acquire::Retries=3 -o Acquire::https::Timeout=30 update \
      && apt-get install -y --no-install-recommends openssl ca-certificates; do \
      if [ "$attempt" -ge 4 ]; then \
        echo "apt package installation failed after ${attempt} attempts" >&2; \
        exit 1; \
      fi; \
      delay=$((attempt * 10)); \
      echo "apt package installation failed; retrying in ${delay}s..."; \
      rm -rf /var/lib/apt/lists/*; \
      sleep "$delay"; \
      attempt=$((attempt + 1)); \
    done; \
    rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=development \
    APP_ENV=development \
    HOST=0.0.0.0 \
    PORT=3000 \
    PRISMA_SKIP_POSTINSTALL_GENERATE=true \
    PRISMA_SCHEMA_PATH=prisma/schema.postgresql.prisma \
    TSC_WATCHFILE=DynamicPriorityPolling \
    TSC_WATCHDIRECTORY=DynamicPriorityPolling \
    npm_config_fetch_retries=5 \
    npm_config_fetch_retry_mintimeout=20000 \
    npm_config_fetch_retry_maxtimeout=120000 \
    npm_config_fetch_timeout=300000 \
    npm_config_maxsockets=5

COPY package*.json ./

# Reuse npm downloads between Docker builds and retry transient connection
# failures instead of failing the whole dev environment on the first timeout.
RUN --mount=type=cache,target=/root/.npm \
    sh -c 'set -e; \
      for attempt in 1 2 3 4; do \
        echo "npm ci attempt ${attempt}/4"; \
        if npm ci --prefer-offline --no-audit --no-fund; then \
          exit 0; \
        fi; \
        if [ "$attempt" -eq 4 ]; then \
          echo "npm ci failed after 4 attempts" >&2; \
          exit 1; \
        fi; \
        delay=$((attempt * 10)); \
        echo "npm ci failed; retrying in ${delay}s..."; \
        sleep "$delay"; \
      done'

# Seed the named node_modules volume from the image. Application source is
# bind-mounted by compose.dev.yaml, so normal code edits never rebuild this image.
COPY nest-cli.json tsconfig*.json ./
COPY scripts ./scripts
COPY prisma ./prisma

EXPOSE 3000

CMD ["npm", "run", "start:dev"]
