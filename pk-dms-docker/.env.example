# PostgreSQL container
POSTGRES_DB=document_tracking
POSTGRES_USER=dms_user
POSTGRES_PASSWORD=change_this_password

# Backend database connection inside Docker
DATABASE_URL=postgresql://dms_user:change_this_password@db:5432/document_tracking?schema=public
REDIS_URL=redis://redis:6379

# Host ports exposed on the office server
FRONTEND_PORT=3000
BACKEND_PORT=3001

# Local development default. Change to your LAN IP only when you need other devices to reach the API.
PUBLIC_API_URL=http://localhost:3001/api/v1
SERVER_PUBLIC_BASE_URL=http://localhost:3001

# Backend response caching and API rate limiting
CACHE_TTL_MS=15000
CACHE_MAX_ITEMS=500
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Optional frontend build flags
DOCUMENT_ASSISTANT_ENABLED=true
DOCUMENT_ASSISTANT_TITLE=Document Assistant
SOFTCOPY_MAX_FILE_SIZE_BYTES=104857600

# Online AI provider used by the document assistant
MISTRAL_ENABLED=true
MISTRAL_API_KEY=replace_with_mistral_api_key
MISTRAL_MODEL=mistral-small-latest
MISTRAL_API_URL=https://api.mistral.ai/v1/chat/completions
MISTRAL_TIMEOUT_MS=10000

# Automatic local backup schedule
BACKUP_AUTO_ENABLED=true
BACKUP_AUTO_TIME=17:00
BACKUP_AUTO_TIMEZONE=Asia/Manila
BACKUP_AUTO_RETRY_MS=900000
BACKUP_RETENTION_ENABLED=true
BACKUP_RETENTION_DAYS=30

# Optional Backblaze B2 background sync
BACKBLAZE_B2_ENABLED=false
BACKBLAZE_B2_KEY_ID=
BACKBLAZE_B2_APPLICATION_KEY=
BACKBLAZE_B2_BUCKET_ID=
BACKBLAZE_B2_BACKUP_PREFIX=dms-backups
BACKBLAZE_B2_SYNC_INTERVAL_MS=60000
BACKBLAZE_B2_RETRY_BASE_MS=60000
BACKBLAZE_B2_RETRY_MAX_MS=900000
